# Patchli Environment Variables

# Required: PostgreSQL password
POSTGRES_PASSWORD=your_secure_postgres_password

# Required: Secret key for signing Agent authentication tokens (at least 16 chars recommended)
JWT_SECRET=your_secure_jwt_secret_at_least_16_chars

# Required: Secret key for generating HMAC setup signatures
REGISTRATION_SECRET=your_secure_registration_secret

# Optional: Server configuration
# PORT=8080
# BASE_URL=http://localhost:8080
# REDIS_URL=redis:6379

# Optional: Notifications
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
