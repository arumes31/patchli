# Generate independent random values; do not copy credentials from this file.
POSTGRES_PASSWORD=
JWT_SECRET=
REGISTRATION_SECRET=
ADMIN_TOKEN=

# Public origin used by dashboards, generated installers, and WebSocket origin checks.
BASE_URL=https://patchli.example.com:8443
PATCHLI_BIND_ADDRESS=127.0.0.1
PATCHLI_PORT=8443
TLS_CERT_FILE=./secrets/tls.crt
TLS_KEY_FILE=./secrets/tls.key

# Optional HTTPS-only outbound integrations.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Native agent configuration (not consumed by docker-compose.yml).
SERVER_URL=https://patchli.example.com:8443
SERVER_CA_FILE=
TRUSTED_PUB_KEY=
ALLOW_REMOTE_SCRIPTS=false
