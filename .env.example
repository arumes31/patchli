# Patchli Environment Variables
# Copy this file to .env and fill in secure values before running docker-compose

POSTGRES_PASSWORD=your_secure_db_password_here
JWT_SECRET=your_secure_jwt_secret_here
REGISTRATION_SECRET=your_secure_registration_secret_here
REDIS_PASSWORD=your_secure_redis_password_here
# High-entropy bearer token for the admin API, e.g. `openssl rand -hex 32`.
# The admin API (including the setup script endpoint) is disabled while unset.
ADMIN_TOKEN=
# Public URL of the server; always set this in production.
BASE_URL=http://localhost:8080
# Optional: base64 Ed25519 private key (32-byte seed) used to sign agent
# commands. Configure the matching public key as COMMAND_PUB_KEY on agents.
COMMAND_SIGNING_KEY=
COMMAND_PUB_KEY=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
