# Patchli Configuration Template
# Copy this file to .env and fill in the required values.

# [REQUIRED] PostgreSQL password
POSTGRES_PASSWORD=your_secure_db_password_here

# [REQUIRED] Secret key for signing Agent authentication tokens (min 16 chars)
JWT_SECRET=your_secure_jwt_secret_here_at_least_16_chars

# [REQUIRED] Secret key for generating HMAC setup signatures
REGISTRATION_SECRET=your_secure_registration_secret_here

# [OPTIONAL] External URL of the server
# BASE_URL=http://localhost:8080

# [OPTIONAL] API Port
# PORT=8080

# [OPTIONAL] Notification Webhooks
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
